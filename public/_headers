/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), microphone=(), geolocation=(), magnetometer=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Fingerprinted build output. Vite puts a content hash in these filenames, so a
# new deploy produces new names and "immutable" is safe - the old file is simply
# never requested again.
/assets/*.js
  Cache-Control: max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: max-age=31536000, immutable

# CSS is fingerprinted too (vite.config.ts assetFileNames), so it can be
# immutable like the JS. It was a stable name with max-age=0 until 2026-08-25,
# when Cloudflare's zone Browser Cache TTL (4h) silently raised that max-age and
# returning visitors paired the old stylesheet with the new HTML.
/assets/*.css
  Cache-Control: max-age=31536000, immutable
